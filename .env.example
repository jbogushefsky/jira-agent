# Anthropic / Claude Code CLI (headless auth inside containers)
ANTHROPIC_API_KEY=

# Jira Cloud (used by both the mcp-atlassian container and any direct links the UI renders)
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=you@your-org.com
JIRA_API_TOKEN=
# Comma-separated Jira project keys to poll, e.g. "PROJ,OPS"
JIRA_PROJECT_KEYS=
# Optional: custom field id holding acceptance criteria (falls back to regex over description)
JIRA_ACCEPTANCE_CRITERIA_FIELD=

# LangSmith observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=jira-agent-dev
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Existing local Postgres instance (NOT containerized by this project)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=vectorjira
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# Backend poller
POLL_INTERVAL_SECONDS=30

# Path (inside the backend container) where sibling project repos are mounted.
# Do not change unless the docker-compose.yml volume mapping also changes.
WORKSPACES_ROOT=/workspaces
